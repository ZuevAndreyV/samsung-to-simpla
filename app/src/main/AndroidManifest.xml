<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    xmlns:tools="http://android.com">

    <!-- Запрашиваем доступ в интернет для отправки на simplerun.ru -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Simpla Sync"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">
        
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Обязательно для Health Connect (чтобы Android знал, какие данные мы читаем) -->
        <meta-data
            android:name="health_permissions"
            android:resource="@array/health_permissions" />

    </application>

    <!-- Проверка видимости пакета Health Connect в системе -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

</manifest>
