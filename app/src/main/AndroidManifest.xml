<?xml version="1.0" encoding="utf-8"?>


<manifest xmlns:android="http://android.com">

    <!-- Права доступа для Health Connect и интернета -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Samsung To Simpla"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">
        
        <activity
            android:name="com.example.sync.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Обязательный системный провайдер для Health Connect -->
        <activity-alias
            android:name="com.example.sync.ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity="com.example.sync.MainActivity">
            <intent-filter>
                <action android:name="androidx.health.connect.client.ACTION_VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
